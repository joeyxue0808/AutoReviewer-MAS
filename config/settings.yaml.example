# AutoReviewer-MAS 全局配置 V3.0
# 复制此文件为 settings.yaml 并填入真实值
# cp config/settings.yaml.example config/settings.yaml

# LLM 配置
llm:
  roles:
    reviewer:
      base_url: "https://your-llm-gateway.com/v1"
      model: "your-model-name"
      api_key_env: "MIMO_API_KEY"      # 环境变量名，或直接填入 API Key
      temperature: 0.3
      max_tokens: 4096
      prefix_caching: false             # 启用前缀缓存（需 LLM Provider 支持，如 Claude 3.5/vLLM）
    fixer:
      base_url: "https://your-llm-gateway.com/v1"
      model: "your-model-name"
      api_key_env: "MIMO_API_KEY"
      temperature: 0.2
      max_tokens: 8192
      prefix_caching: false             # 启用前缀缓存（需 LLM Provider 支持）
    tester:
      base_url: "https://your-llm-gateway.com/v1"
      model: "your-model-name"
      api_key_env: "MIMO_API_KEY"
      temperature: 0.1
      max_tokens: 2048
      prefix_caching: false             # 启用前缀缓存（需 LLM Provider 支持）

  retry:
    max_attempts: 5           # 最大重试次数
    # 以下参数由自适应退避策略覆盖（429 限流自动延长等待）
    min_wait_seconds: 2
    max_wait_seconds: 10
    multiplier: 1

# 9-Language Sandbox Matrix
sandbox:
  default_engine: "docker"   # 或 "shell"（开发调试用）或 "auto"（自适应降级）
  timeout: 300
  mem_limit: "512m"          # Docker 内存限制
  cpu_quota: 50000           # Docker CPU 配额

  matrix:
    go:
      suffixes: [".go"]
      image: "golang:1.23-alpine"
      lint_command: "golangci-lint run"
      test_command: "go test ./..."
    python:
      suffixes: [".py"]
      image: "python:3.12-slim"
      lint_command: "ruff check ."
      test_command: "pytest"
    cpp:
      suffixes: [".cpp", ".h", ".cc", ".hpp"]
      image: "gcc:latest"
      lint_command: "cpplint"
      test_command: "cmake . && make && ctest"
    java:
      suffixes: [".java"]
      image: "maven:3.9-eclipse-temurin-21"
      lint_command: "checkstyle"
      test_command: "mvn test"
    vue:
      suffixes: [".vue"]
      image: "node:20-alpine"
      lint_command: "eslint --ext .vue src"
      test_command: "vitest run"
    javascript:
      suffixes: [".js", ".cjs", ".mjs"]
      image: "node:20-alpine"
      lint_command: "eslint ."
      test_command: "npm test"
    typescript:
      suffixes: [".ts", ".tsx"]
      image: "node:20-alpine"
      lint_command: "tsc --noEmit"
      test_command: "npm test"
    flutter:
      suffixes: [".dart"]
      image: "ghcr.io/cirruslabs/flutter:stable"
      lint_command: "dart analyze"
      test_command: "flutter test"
    csharp:
      suffixes: [".cs"]
      image: "mcr.microsoft.com/dotnet/sdk:8.0"
      lint_command: "dotnet format"
      test_command: "dotnet test"

# VCS 平台配置
gitlab:
  api_url: "https://gitlab.example.com/api/v4"
  token_env: "GITLAB_TOKEN"

github:
  api_url: "https://api.github.com"
  token_env: "GITHUB_TOKEN"

# Webhook 安全
# webhook:
#   gitlab_secret: "your-gitlab-webhook-token"
#   github_secret: "your-github-webhook-secret"

# 审批通知（HITL）
# APPROVAL_WEBHOOK_URL: 飞书/钉钉 Webhook（自动识别渠道类型）
# WECOM_WEBHOOK_URL: 企业微信 Webhook
# 可同时配置，通知会发送到所有已配置的渠道
# approval:
#   webhook_url: ""  # 或通过环境变量 APPROVAL_WEBHOOK_URL
#   wecom_url: ""    # 或通过环境变量 WECOM_WEBHOOK_URL

max_retry_count: 3

# 多轮审查配置
multiround:
  enabled: true            # 启用多轮审查
  max_rounds: 3           # 最大审查轮次
  auto_approve: false      # 是否自动批准修复（无需用户确认）
  convergence_threshold: 2 # 连续无新问题的轮次阈值，达到后自动停止
  user_input_timeout: 30   # 用户输入超时时间（秒）

# 消息队列 (Redis Streams)
queue:
  redis_url: "redis://localhost:6380/0"
  stream_key: "mr_review_queue"
  consumer_group: "review_workers"
  consumer_name: "worker-1"
  max_len: 10000

# 持久化检查点 (Postgres)
checkpointer:
  enabled: true
  postgres_url: "postgresql://postgres:postgres@localhost:5432/autoreviewer"

# 熔断器 (pybreaker)
circuit_breaker:
  enabled: true
  fail_max: 5
  reset_timeout: 60
  exclude_exceptions:
    - "ValueError"
    - "KeyError"

# ── V3.0 新增 ──

# 零依赖模式（本地开发用，禁用 Redis/Postgres/Docker）
# local_mode:
#   enabled: true           # true 时自动使用内存队列 + SQLite checkpointer
#   queue: "memory"         # memory | redis
#   checkpointer: "sqlite"  # sqlite | postgres
#   sandbox: "auto"         # auto | docker | shell | skip

# RAG 语义代码搜索（可选）
# rag:
#   enabled: true
#   embedding_model: "text-embedding-3-small"   # 或本地模型 "all-MiniLM-L6-v2"
#   embedding_api_base: "https://your-llm-gateway.com/v1"
#   db_path: ".lancedb"
#   top_k: 10
